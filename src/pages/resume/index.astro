<script>
    const nav = document.querySelector(".resume-toc");
    if (nav) {
        const links = [...nav.querySelectorAll("a[href^='#']")];
        const headings = links
            .map((a) =>
                document.getElementById(
                    decodeURIComponent(a.getAttribute("href")?.slice(1) ?? ""),
                ),
            )
            .filter((el): el is HTMLElement => el instanceof HTMLElement);

        const setActive = (id: string) => {
            for (const a of links) {
                a.classList.toggle(
                    "is-active",
                    decodeURIComponent(a.getAttribute("href") ?? "") ===
                        `#${id}`,
                );
            }
        };

        const observer = new IntersectionObserver(
            (entries) => {
                const visible = entries
                    .filter((e) => e.isIntersecting)
                    .sort(
                        (a, b) =>
                            a.boundingClientRect.top - b.boundingClientRect.top,
                    );
                if (visible[0]?.target.id) setActive(visible[0].target.id);
            },
            { rootMargin: "-15% 0px -70% 0px", threshold: 0 },
        );

        for (const el of headings) observer.observe(el);

        const nativeSmoothMs = 500;
        const durationMs = nativeSmoothMs / 1.25;
        let scrollFrame = 0;

        const easeOutCubic = (t: number) => 1 - (1 - t) ** 3;

        nav.addEventListener("click", (event) => {
            const a = (event.target as Element | null)?.closest("a[href^='#']");
            if (!(a instanceof HTMLAnchorElement)) return;

            const id = decodeURIComponent(a.hash.slice(1));
            const el = document.getElementById(id);
            if (!el) return;

            event.preventDefault();
            history.pushState(null, "", a.hash);
            setActive(id);

            const marginTop =
                parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
            const end =
                el.getBoundingClientRect().top + window.scrollY - marginTop;
            const reduced = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (reduced) {
                window.scrollTo(0, end);
                return;
            }

            const start = window.scrollY;
            const delta = end - start;
            const started = performance.now();
            cancelAnimationFrame(scrollFrame);

            const step = (now: number) => {
                const t = Math.min(1, (now - started) / durationMs);
                window.scrollTo(0, start + delta * easeOutCubic(t));
                if (t < 1) scrollFrame = requestAnimationFrame(step);
            };
            scrollFrame = requestAnimationFrame(step);
        });
    }
</script>
